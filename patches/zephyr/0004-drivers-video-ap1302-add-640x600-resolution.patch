From 664e7125f2da0e4dbcd7da1d32a7d9c5d7e35c46 Mon Sep 17 00:00:00 2001
From: Chekhov Ma <chekhov.ma@nxp.com>
Date: Wed, 20 Aug 2025 19:44:58 +0800
Subject: [PATCH 4/4] drivers: video: ap1302: add 640x600 resolution

This is required by barcode scanner demo

Signed-off-by: Chekhov Ma <chekhov.ma@nxp.com>
---
 drivers/video/ap1302.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/video/ap1302.c b/drivers/video/ap1302.c
index c71ff29f4bf..707ae432507 100644
--- a/drivers/video/ap1302.c
+++ b/drivers/video/ap1302.c
@@ -99,6 +99,12 @@ static const struct ap1302_mode_config ap1302_modes[] = {
 		.max_frmrate = AP1302_60_FPS,
 		.def_frmrate = AP1302_60_FPS,
 	},
+	{
+		.width = 640,
+		.height = 600,
+		.max_frmrate = AP1302_60_FPS,
+		.def_frmrate = AP1302_60_FPS,
+	},
 	{
 		.width = 1280,
 		.height = 720,
@@ -129,6 +135,7 @@ static const int ap1302_frame_rates[] = {AP1302_15_FPS, AP1302_30_FPS, AP1302_45
 static const struct video_format_cap ap1302_fmts[] = {
 	AP1302_VIDEO_FORMAT_CAP(640, 480, VIDEO_PIX_FMT_UYVY),
 	AP1302_VIDEO_FORMAT_CAP(1024, 600, VIDEO_PIX_FMT_UYVY),
+	AP1302_VIDEO_FORMAT_CAP(640, 600, VIDEO_PIX_FMT_UYVY),
 	AP1302_VIDEO_FORMAT_CAP(1280, 720, VIDEO_PIX_FMT_UYVY),
 	AP1302_VIDEO_FORMAT_CAP(1280, 800, VIDEO_PIX_FMT_UYVY),
 	AP1302_VIDEO_FORMAT_CAP(1920, 1080, VIDEO_PIX_FMT_UYVY),
-- 
